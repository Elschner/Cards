# Local database file (created by `npx prisma db push`)
DATABASE_URL="file:./dev.db"

# Login for the web app (browser asks for these). Required when hosted;
# if APP_PASSWORD is empty in local dev, login is skipped.
APP_USERNAME="admin"
APP_PASSWORD=""

# Scryfall requires an honest User-Agent identifying your app + contact
SCRYFALL_USER_AGENT="CardOps/0.1 (you@example.com)"

# Card recognition from photos (Claude vision). Leave empty to use manual search only.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"

# Cardmarket API (MKM API 2.0, "Dedicated App"). Cardmarket is NOT issuing new API
# credentials right now — leave empty and use the CSV export until you have them.
CARDMARKET_APP_TOKEN=""
CARDMARKET_APP_SECRET=""
CARDMARKET_ACCESS_TOKEN=""
CARDMARKET_ACCESS_SECRET=""
# Verify the current base URL in Cardmarket's API docs before first live use.
CARDMARKET_API_BASE="https://apiv2.cardmarket.com/ws/v2.0/output.json"
# Safety switch: when "true", the API adapter logs the request instead of sending it.
CARDMARKET_DRY_RUN="true"

# Uploaded card photos are kept in this folder (useful for grading later).
# Leave empty to discard photos after recognition.
UPLOAD_DIR="./uploads"
