generator client {
  provider = "prisma-client-js"
}

// SQLite: a single local file (dev.db), zero setup. To host online later,
// change provider to "postgresql" and point DATABASE_URL at Neon (see README).
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A specific printing, cached from Scryfall.
model Card {
  scryfallId      String    @id
  name            String
  setCode         String
  setName         String
  collectorNumber String
  lang            String
  rarity          String
  cardmarketId    Int?      // Cardmarket idProduct (from Scryfall) — the key for listing
  imageUrl        String?
  priceEur        Float?    // Scryfall EUR price (sourced from Cardmarket trend)
  priceEurFoil    Float?
  pricesUpdatedAt DateTime?
  items           InventoryItem[]
}

// Chaos storage: boxes with numbered slots. A card goes into any free slot.
model Box {
  id       Int             @id @default(autoincrement())
  code     String          @unique // e.g. "B001"
  capacity Int
  items    InventoryItem[]
}

// One row = one physical copy. Keeps location tracking exact.
model InventoryItem {
  id         Int       @id @default(autoincrement())
  card       Card      @relation(fields: [scryfallId], references: [scryfallId])
  scryfallId String
  condition  String    // MT, NM, EX, GD, LP, PL, PO (Cardmarket scale)
  foil       Boolean   @default(false)
  language   String    @default("en") // Scryfall lang code
  status     String    @default("IN_STOCK") // IN_STOCK, LISTED, SOLD, REMOVED
  box        Box?      @relation(fields: [boxId], references: [id])
  boxId      Int?
  slot       Int?
  sku        String?   @unique // C-000123: one ID per physical copy, used on every channel
  purchase   Purchase? @relation(fields: [purchaseId], references: [id])
  purchaseId Int?
  askPrice   Float?    // EUR
  costBasis  Float?    // EUR, what you paid (allocated from the purchase)
  soldPrice  Float?    // EUR, gross sale price
  soldAt     DateTime?
  photoPath  String?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  listings   Listing[]

  @@unique([boxId, slot])
  @@index([status])
  @@index([purchaseId])
}

// A collection bought in one go. Its total price is spread over the cards in it.
model Purchase {
  id          Int             @id @default(autoincrement())
  name        String          // e.g. "Samling fra DBA, Peter"
  purchasedAt DateTime        @default(now())
  totalCost   Float           // EUR, everything paid incl. shipping
  method      String          @default("VALUE") // VALUE = by market value, EQUAL = same per card
  notes       String?
  createdAt   DateTime        @default(now())
  items       InventoryItem[]
}

model Listing {
  id         Int           @id @default(autoincrement())
  item       InventoryItem @relation(fields: [itemId], references: [id])
  itemId     Int
  channel    String        // CARDMARKET, TRADERA, EBAY
  method     String        // API, CSV
  externalId String?       // e.g. Cardmarket idArticle
  price      Float
  status     String        // PENDING, ACTIVE, FAILED, ENDED, SOLD
  error      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([channel, status])
}
